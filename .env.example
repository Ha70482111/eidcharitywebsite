# Copy this file to .env (local) or add these as environment variables in cPanel → Setup Node.js App

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_eid
DB_USER=cpaneluser_eid
DB_PASSWORD=change-me

# Optional: secret used to sign admin login tokens.
# If left empty, a random secret is generated and stored in the database automatically.
APP_SECRET=

# Port for local runs (cPanel sets this automatically)
PORT=3000
