# Only index.php may be requested directly; config, seed data and helpers stay private.
<FilesMatch "^(config\.php|db\.php|auth\.php|seed\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
